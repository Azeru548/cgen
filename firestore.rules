rules_version = '2';

// Firestore security rules for cgen (M11).
//
// Per-user data lives entirely under users/{uid}. Every match below requires
// that the signed-in user's uid equals the {uid} path segment, so a client
// cannot read or write another user's projects even if it crafts the path.
// There is no catch-all allow and no public read anywhere in this file.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true only when the caller owns this {uid} subtree.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // A project shell: name, serial, active workspace pointer, counters.
    match /users/{uid}/projects/{projectId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200;
      // The owner may change the shell but never re-parent it to another user,
      // and the owner id itself is immutable by construction (path segment).
      allow update: if isOwner(uid)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200;
      allow delete: if isOwner(uid);

      // Workspaces inside the project.
      match /workspaces/{workspaceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                               && request.resource.data.name is string
                               && request.resource.data.name.size() <= 200;
        allow delete: if isOwner(uid);

        // Revisions are append-only: no updates, no deletes. This mirrors the
        // product rule that history is never rewritten.
        match /revisions/{revisionId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
                        && request.resource.data.kind is string
                        && request.resource.data.createdAt is string
                        && request.resource.data.prompt is string
                        && request.resource.data.prompt.size() <= 4000;
          allow update, delete: if false;
        }
      }
    }

    // A user may read their own profile document if one is ever added.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
