# Server-side configuration for local backend development.
#
# This file is a template, not auto-loaded: the app reads process environment
# variables. Export the values in your shell, or copy this file to `.env` and
# let your IDE / process manager load it. Never commit a real `.env`.
# PowerShell example:
#   $env:GROQ_API_KEY="gsk_..."
#   $env:BYTESHIP_API_KEY="bship_..."
#   $env:CORS_ORIGINS="http://localhost:3000"

# Required for the AI pipeline (/generate, /modify).
GROQ_API_KEY=

# Optional. STL mesh resolution for the viewer. Linear deflection in mm and
# angular tolerance in radians; defaults 0.01 / 0.1. CadQuery's own default is
# 0.1 mm, which makes bores and spheres visibly faceted. Larger = lighter files,
# coarser curves; smaller = smoother, bigger files.
STL_TOLERANCE=
STL_ANGULAR_TOLERANCE=

# Optional. Artifact delivery backend (M10.2).
#   set    -> generated STEP/STL are uploaded to Byteship and download_url
#             becomes the Byteship CDN delivery URL
#   unset  -> the in-process /download/{token} store is used instead
BYTESHIP_API_KEY=

# Browser origin allowed to call this API (comma-separated). Defaults to the
# Next.js dev server. Add your deployed frontend origin for production.
CORS_ORIGINS=http://localhost:3000

# Optional accounts. Set the Firebase project id that issued the ID tokens,
# then REQUIRE_AUTH=true to reject anonymous calls. Leave both unset to run
# the API without accounts.
FIREBASE_PROJECT_ID=
REQUIRE_AUTH=false
